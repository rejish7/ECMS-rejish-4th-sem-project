DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecmss
DB_USERNAME=root
DB_PASSWORD=

# SMTP settings for sending account credentials. When MAIL_HOST is empty the
# app falls back to PHP's mail(). For Gmail use smtp.gmail.com:587 with an
# App Password. For local testing, services like Mailtrap work well.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ecms.local
MAIL_FROM_NAME=ECMS
MAIL_ENCRYPTION=tls
